[Unit]
Description=sbox-panel - Lightweight sing-box Management Panel
Documentation=https://github.com/sbox-panel/sbox-panel
After=network-online.target nss-lookup.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/var/lib/sbox-panel
StateDirectory=sbox-panel
StateDirectoryMode=0750
EnvironmentFile=-/etc/default/sbox-panel
ExecStart=/usr/local/bin/sbox-panel serve --data-dir /var/lib/sbox-panel --listen 0.0.0.0:18080

Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillMode=mixed

# High descriptor limit for concurrent proxy connections
LimitNOFILE=1048576
TasksMax=4096

# Grant privileged port binding (ports 80/443 for ACME HTTP-01, HTTPS, and proxy
# inbounds) while dropping unnecessary root capabilities.
# Add CAP_NET_ADMIN if enabling a sing-box TUN inbound.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Filesystem & kernel hardening. /var/lib/sbox-panel remains writable and
# executable so sbox-panel can manage /var/lib/sbox-panel/bin/sing-box.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Set ProtectHome=read-only if referencing external TLS certificates under /root or /home
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/sbox-panel

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sbox-panel

[Install]
WantedBy=multi-user.target
